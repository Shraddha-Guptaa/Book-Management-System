@model UserDTO
    <div class="container d-flex justify-content-center align-items-center min-vh-150">
        <div class="card shadow-lg p-4" style="width: 100%; max-width: 420px;">

        <h3 class="text-center mb-4 text-primary">Login</h3>

        <form asp-controller="Registration" asp-action="Login" method="post">

                <!-- Username -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">User Name</label>
                <input type="text" class="form-control" asp-for="username" placeholder="Enter username" />
                    <span asp-validation-for="username" class="text-danger"></span>
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Password</label>
                <input type="password" class="form-control" asp-for="password" placeholder="Enter password" />
                    <span asp-validation-for="password" class="text-danger"></span>
                </div>
            <!-- role -->

         

                <!-- Register Button -->
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary fw-bold">
                    Login
                    </button>
                </div>

                <!-- Login Link -->
                <div class="text-center mt-3">
                    <small>
                        don't have an account?
                        <a asp-controller="Home" asp-action="Register" class="text-decoration-none">
                            Register
                        </a>
                    </small>
                </div>

            </form>
        </div>
    </div>

