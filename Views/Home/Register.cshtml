@model User
<div class="container d-flex justify-content-center align-items-center min-vh-200">
    <div class="card shadow-lg p-4" style="width: 100%; max-width: 620px;">

        <h3 class="text-center mb-4 text-primary">Register</h3>

        <form asp-controller="Registration" asp-action="Register" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="row">
                <!-- Username -->
                <div class="col-6 mb-3">
                    <label class="form-label fw-semibold">User Name</label>
                    <input type="text" class="form-control" asp-for="Username" placeholder="Enter username" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <!-- Password -->
                <div class="col-6  mb-3">
                    <label class="form-label fw-semibold">Password</label>
                    <input type="password" class="form-control" asp-for="PasswordHash" placeholder="Enter password" />
                    <span asp-validation-for="PasswordHash" class="text-danger"></span>
                </div>
            </div>
            <div class="row">

                <!-- Password -->
                <div class="col-6 mb-3">
                    <label class="form-label fw-semibold">Confirm Password</label>
                    <input type="password" class="form-control" asp-for="ConfirmPassword" placeholder="Enter password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <!-- role -->

                <div class="col-6 mb-3">
                    <label class=" fw-semibold">Role</label>

                    <select class="form-select" asp-for="Roles
">
                        <option value="">-- Select Role --</option>
                        <option value="Admin">Admin</option>
                        <option value="Customer">Customer</option>
                    </select>

                    <span asp-validation-for="Roles" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <!-- email -->
                <div class="col-6 mb-3">
                    <label class="form-label fw-semibold">Email </label>
                    <input type="email" class="form-control" asp-for="email" placeholder="Enter Email Address" />
                    <span asp-validation-for="email" class="text-danger"></span>
                </div>
                <!-- mobile -->
                <div class="col-6 mb-3">
                    <label class="form-label fw-semibold">Mobile No </label>
                    <input type="text" class="form-control" asp-for="MobileNo" placeholder="Enter Mobile No" />
                    <span asp-validation-for="MobileNo" class="text-danger"></span>
                </div>

            </div>
            <!-- address -->
            <div class="mb-3">
                <label class="form-label fw-semibold">Address  </label>
                <input type="text" class="form-control" asp-for="Address" placeholder="Enter Address" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <!-- Register Button -->
            <div class="d-grid">
                <button type="submit" class="btn btn-primary fw-bold">
                    Register
                </button>
            </div>

            <!-- Login Link -->
            <div class="text-center mt-3">
                <small>
                    Already have an account?
                    <a asp-controller="Home" asp-action="Login" class="text-decoration-none">
                        Login
                    </a>
                </small>
            </div>

        </form>
    </div>
</div>

