@model ProductVM

<form method="post" enctype="multipart/form-data">
    <input asp-for="product.ProductId" hidden />
    <input asp-for="product.ImageUrl" hidden />
    <div class="border p-3 mt-4">
        @if (@Model.product.ProductId != 0)
        {
            <div class="row pb-2">
                <h2 class="text-dark">Update Product</h2>
            </div>
        }
        else
        {
            <div class="row pb-2">
                <h2 class="text-dark">Create Product</h2>
            </div>
        }

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="row">
            <div class="col-md-10">

                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Product Name</label>
                            <input type="text" asp-for="product.title" class="form-control" />
                            <span asp-validation-for="product.title" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">ISBN</label>
                            <input type="text" asp-for="product.ISBN" class="form-control" />
                            <span asp-validation-for="product.ISBN" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                    <div class="col-md-6">
                        <label>Author</label>
                        <input type="text" asp-for="product.Author" class="form-control" />
                        <span asp-validation-for="product.Author" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label>Lastprice</label>
                        <input type="text" asp-for="product.Lastprice" class="form-control" />
                        <span asp-validation-for="product.Lastprice" class="text-danger"></span>
                    </div>
                </div>
                    <div class="row">
                <div class="col-md-6">
                    <label>price</label>
                    <input type="text" asp-for="product.price" class="form-control" />
                    <span asp-validation-for="product.price" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label>Price for 50+</label>
                    <input type="text" asp-for="product.price50" class="form-control" />
                    <span asp-validation-for="product.price50" class="text-danger"></span>
                </div>
                </div>
                <div class="row">

                <div class="col-md-6">
                    <label>Price for 100+</label>
                    <input type="text" asp-for="product.price100" class="form-control" />
                    <span asp-validation-for="product.price100" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label>Category</label>
                    <select asp-for="product.categoryid"
                            asp-items="Model.CategoryList"
                            class="form-control mg-6">
                        <option value="">--Select Category--</option>
                    </select>
                    <span asp-validation-for="product.categoryid" class="text-danger"></span>
                </div>
                </div>
                <div class="col-md-12">
                    <label>Image Upload</label>
                    <input type="file" asp-for="product.ImageUrl" name="file" class="form-control" />
                </div>
                <div class="col-md-12 form-control">
                    <label>Description</label>
                    <input type="text" asp-for="product.description" class="form-control" />
                    <span asp-validation-for="product.description" class="text-danger"></span>
                </div>

            </div>
            <div class="col-md-2">
                <div class=" form-control border-1-mg">

                    <img src="@Model.product.ImageUrl" width="100%" />

                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                @if (@Model.product.ProductId != 0)
                {
                    <button type="submit" class="btn btn-primary form-control border-0 shadow">Update</button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary form-control border-0 shadow">Submit</button>
                }
            </div>
            <div class="col-md-6">
                <a asp-controller="Product" asp-action="Index" class=" btn btn-secondary form-control text-dark">Back To List</a>
            </div>
        </div>
    </div>
</form>