@model Category

<form method="post">
    <input asp-for="id" hidden />
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-dark">Edit Category</h2>
        </div>
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="col-md-12 form-control">
            <label>Category Name</label>
            <input type="text" asp-for="name" class="form-control" disabled/>
            <span asp-validation-for="name" class="text-danger"></span>
        </div>
        <div class="col-md-12 form-control">
            <label>Display Order</label>
            <input type="text" asp-for="DisplayOrder" class="form-control" disabled />
            <span asp-validation-for="DisplayOrder" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-6">
                <button type="submit" class="btn btn-danger form-control">Delete</button>
            </div>
            <div class="col-md-6">
                <a asp-controller="Category" asp-action="Index" class=" btn btn-secondary form-control text-dark">Back To List</a>
            </div>
        </div>
    </div>
</form>