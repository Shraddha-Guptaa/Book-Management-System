@model List<Category>

@*     <partial name="_Notification" /> thif partial view aded on layout so that notiifrcation work on each page
 *@<div class="container">
    <div class="row pt-4 pb-3">
    <div class="col-md-6">
        <h2>List of Categories</h2>
    </div>
    <div class="col-md-6">
            <a asp-controller="Category" asp-action="Create" class="btn btn-secondary form-control text-dark">Create Category</a>
        </div>
    </div>
<table class=" table table-bordered table-striped">
    <thead>
    <tr>
    <th>
        Category Name
    </th>
    <th>
        Display Order
    </th>
    <th colspan="2" style="text-align:center;vertical-align:middle">Action</th>
    </tr>
    </thead>
    <tbody>
        @foreach (var obj in Model.OrderBy(u=>u.DisplayOrder))
        {
            <tr>
                <td>
                    @obj.name
                </td>
                <td>
                    @obj.DisplayOrder
                </td>
                <td>
                    <a type="submit" asp-action="Edit" asp-route-id="@obj.id"  class="form-control btn btn-primary">Edit</a>
                </td>
                <td>
                    <a type="submit" asp-action="Delete" asp-route-id="@obj.id"  class="form-control btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>